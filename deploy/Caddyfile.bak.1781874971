# Caddy auto-obtains and renews the Let's Encrypt certificate for this domain.
# HTTP -> HTTPS redirect is automatic once the cert is in place.

mrr-process-tracker.joulestowatts.com {
    encode zstd gzip

    # RecruitAssist (pnpm monorepo) runs on the host via pm2:
    #   web  = vite preview on :8084, built with base=/ai-interview-agent/
    #   api  = Fastify (HTTP+WS+SSE) on :8787, routes live at /api/* and /ws/*
    # 172.19.0.1 is the docker bridge gateway = the host.
    redir /ai-interview-agent /ai-interview-agent/ 301

    # API + WebSockets: strip the /ai-interview-agent prefix so the api sees
    # /api/* and /ws/* unchanged. The refresh cookie is issued with Path=/api/auth,
    # which the browser sees under the subpath — rewrite it so it's actually sent
    # back on /ai-interview-agent/api/auth/refresh.
    @ra_apiws path /ai-interview-agent/api/* /ai-interview-agent/ws/*
    handle @ra_apiws {
        uri strip_prefix /ai-interview-agent
        reverse_proxy 172.19.0.1:8787 {
            flush_interval -1
            header_down Set-Cookie "Path=/api/auth" "Path=/ai-interview-agent/api/auth"
        }
    }

    # Web SPA (assets carry the /ai-interview-agent prefix already — do NOT strip).
    handle /ai-interview-agent/* {
        reverse_proxy 172.19.0.1:8084
    }

    # J2W AI Scoring Agent (resume-matcher-pro) runs on the host via pm2:
    #   single Express process on :3001 serving /api/* and the built SPA
    #   (client/dist), Vite-built with base=/j2w-ai-scoring-agent/.
    # Strip the prefix so the backend sees / , /assets/* and /api/* unchanged.
    redir /j2w-ai-scoring-agent /j2w-ai-scoring-agent/ 301
    @j2w_scoring path /j2w-ai-scoring-agent/*
    handle @j2w_scoring {
        uri strip_prefix /j2w-ai-scoring-agent
        reverse_proxy 172.19.0.1:3001 {
            flush_interval -1
        }
    }

    # Everything else: the recruiter tracking app container.
    handle {
        # Vite-built hashed assets (filenames change when content changes) → cache forever.
        @assets path /assets/* /hrbp/assets/*
        header @assets Cache-Control "public, max-age=31536000, immutable"

        # Everything else (index.html, /api/*, root-level static files) → no browser cache.
        # This guarantees users always pull the freshest index.html after a deploy, which
        # in turn references the latest hashed JS/CSS so they get the new bundle.
        @nocache not path /assets/* /hrbp/assets/*
        header @nocache Cache-Control "no-store"

        reverse_proxy app:8000 {
            # SSE / EventSource (used by features/notifications) needs streaming + no buffering.
            flush_interval -1
        }
    }
}
